# Kopiere diese Datei nach ".env" und passe die Werte an.

# Port und Adresse, auf der die App lauscht
PORT=3000
HOST=0.0.0.0

# Speicherort für Datenbank und hochgeladene Bilder (unbedingt sichern!)
DATA_DIR=./data

# Erstes Administrator-Konto – wird nur beim allerersten Start angelegt.
ADMIN_USERNAME=marco
ADMIN_DISPLAY_NAME=Marco
# Leer lassen = es wird ein zufälliges Passwort erzeugt und in der Konsole angezeigt
# (muss dann bei der ersten Anmeldung geändert werden).
ADMIN_PASSWORD=

# Hinter einem Reverse-Proxy (Caddy, nginx, Traefik …) auf "true" setzen,
# damit HTTPS und die echte Client-IP (für die Login-Sperre) erkannt werden.
TRUST_PROXY=false

# Secure-Flag für das Login-Cookie: auto | true | false
# "true" aktiviert zusätzlich HSTS – nur setzen, wenn die App ausschließlich per HTTPS läuft.
COOKIE_SECURE=auto

# Kontaktadresse für Web-Push (wird den Push-Diensten von Google/Apple/Mozilla mitgeteilt)
VAPID_SUBJECT=mailto:du@example.com

# Wie lange eine Anmeldung gültig bleibt (Tage, verlängert sich bei Nutzung)
SESSION_DAYS=30

# Maximale Größe pro Bild in MB
MAX_UPLOAD_MB=15
